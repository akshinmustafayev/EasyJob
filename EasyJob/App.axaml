<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:EasyJob.Controls"
             x:Class="EasyJob.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F6F8"/>
          <SolidColorBrush x:Key="FooterBrush" Color="#ECEEF2"/>
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="CardHoverBrush" Color="#F1F5FF"/>
          <SolidColorBrush x:Key="BorderBrushSoft" Color="#DCE0E7"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#2F6FEB"/>
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#2559C4"/>
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3ECFD"/>
          <SolidColorBrush x:Key="SuccessBrush" Color="#18924F"/>
          <SolidColorBrush x:Key="DangerBrush" Color="#D6453D"/>
          <SolidColorBrush x:Key="WarnBrush" Color="#B97D0A"/>
          <SolidColorBrush x:Key="ChipBrush" Color="#E9ECF1"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SurfaceBrush" Color="#16181D"/>
          <SolidColorBrush x:Key="FooterBrush" Color="#1C1F25"/>
          <SolidColorBrush x:Key="CardBrush" Color="#21252C"/>
          <SolidColorBrush x:Key="CardHoverBrush" Color="#293247"/>
          <SolidColorBrush x:Key="BorderBrushSoft" Color="#343A46"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#8E96A5"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#4D88FF"/>
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#6E9DFF"/>
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#25324F"/>
          <SolidColorBrush x:Key="SuccessBrush" Color="#3DD68C"/>
          <SolidColorBrush x:Key="DangerBrush" Color="#FF6B63"/>
          <SolidColorBrush x:Key="WarnBrush" Color="#E5B04A"/>
          <SolidColorBrush x:Key="ChipBrush" Color="#2D333D"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>

    <!-- ===== Typography ===== -->
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="0.6"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Margin" Value="2,18,0,8"/>
    </Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="TextBlock.hint"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
    <Style Selector="StackPanel.labelrow"><Setter Property="Orientation" Value="Horizontal"/><Setter Property="Margin" Value="0,14,0,5"/></Style>
    <Style Selector="StackPanel.labelrow.first"><Setter Property="Margin" Value="0,0,0,5"/></Style>

    <!-- ===== Surfaces ===== -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,1"/>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>

    <!-- ===== Buttons: default (outlined), primary (filled), flat (ghost) ===== -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style Selector="ToggleButton">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
    </Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>

    <!-- "?" help button: small round badge, fills with the accent on hover -->
    <Style Selector="Button.help">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.help:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.helpdot">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1.2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBlock.helpmark">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.help:pointerover Border.helpdot">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.help:pointerover TextBlock.helpmark"><Setter Property="Foreground" Value="White"/></Style>

    <!-- ===== Tabs & lists ===== -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style Selector="TabItem.droptarget"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="ListBoxItem.droptarget"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- ===== Dialog window + shell ===== -->
    <Style Selector="Window.dialog">
      <Setter Property="WindowStartupLocation" Value="CenterOwner"/>
      <Setter Property="ShowInTaskbar" Value="False"/>
      <Setter Property="CanResize" Value="False"/>
      <Setter Property="SizeToContent" Value="Height"/>
    </Style>

    <Style Selector="c|DialogShell">
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="24,14">
              <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right"/>
            </Border>
            <StackPanel DockPanel.Dock="Top" Margin="24,22,24,0" Spacing="3">
              <TextBlock Text="{TemplateBinding Heading}" Classes="h1" TextWrapping="Wrap"/>
              <TextBlock Text="{TemplateBinding Subheading}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{TemplateBinding Subheading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <ContentPresenter Content="{TemplateBinding Content}" Margin="24,14,24,20"/>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
