<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:EasyJob.Controls"
        x:Class="EasyJob.Dialogs.PromptDialog"
        Classes="dialog" Width="440">
  <c:DialogShell x:Name="Shell">
    <StackPanel Spacing="6">
      <TextBlock x:Name="LabelText" Classes="label"/>
      <TextBox x:Name="Input"/>
    </StackPanel>
    <c:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" MinWidth="90" Click="OnCancel"/>
        <Button x:Name="OkButton" Classes="primary" Content="OK" MinWidth="90" IsDefault="True" Click="OnOk"/>
      </StackPanel>
    </c:DialogShell.Footer>
  </c:DialogShell>
</Window>
