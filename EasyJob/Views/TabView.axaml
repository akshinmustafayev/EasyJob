<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyJob.ViewModels"
             xmlns:views="using:EasyJob.Views"
             xmlns:c="using:EasyJob.Controls"
             x:Class="EasyJob.Views.TabView"
             x:DataType="vm:TabViewModel">

  <UserControl.Styles>
    <Style Selector="Button.script">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,11,38,11"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.script:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Panel.scriptcard.droptarget > Button.script">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <!-- the "more" button only shows while the card is hovered -->
    <Style Selector="Panel.scriptcard > Button.more"><Setter Property="Opacity" Value="0"/></Style>
    <Style Selector="Panel.scriptcard:pointerover > Button.more"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Panel.scriptcard > Button.more:focus"><Setter Property="Opacity" Value="1"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="20,16,20,12">

    <!-- toolbar -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
      <TextBox x:Name="FilterBox" Width="260" Watermark="Filter scripts…" Text="{Binding Filter}" IsVisible="{Binding ShowFilter}"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="PasteButton" Click="OnPasteScript" ToolTip.Tip="Paste the copied script button" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="paste"/><TextBlock Text="Paste"/></StackPanel>
        </Button>
        <Button x:Name="ReorderButton" Click="OnReorderScripts" ToolTip.Tip="Change the order of the buttons in this tab">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="reorder"/><TextBlock Text="Reorder"/></StackPanel>
        </Button>
        <Button x:Name="AddScriptButton" Classes="primary" Click="OnAddScript" ToolTip.Tip="Add a script button (Ctrl/Cmd+N)">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="plus" Width="13" Height="13"/><TextBlock Text="Add script"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- scripts -->
    <Border Grid.Row="1" x:Name="PanelArea" Background="Transparent" PointerReleased="OnPanelReleased">
      <Grid>
        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasButtons}">
          <ItemsControl ItemsSource="{Binding FilteredButtons}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ButtonViewModel">
                <Panel Classes="scriptcard" Width="270" Margin="0,0,10,10">
                  <Button Classes="script" Click="OnRunClick" PointerReleased="OnButtonReleased" ToolTip.Tip="{Binding Tooltip}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}" Margin="0,0,11,0" VerticalAlignment="Center">
                        <c:Icon Kind="play" Foreground="White" Width="12" Height="12" Margin="2,0,0,0"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                          <Border Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="SemiBold" Classes="muted"/></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasDescription}"/>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="flat more" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" Padding="6,4"
                          Click="OnMoreClick" ToolTip.Tip="More actions">
                    <c:Icon Kind="more" Width="14" Height="14"/>
                  </Button>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock IsVisible="{Binding NoMatches}" Classes="muted" Text="No scripts match your filter." Margin="2,6" />

        <Border IsVisible="{Binding !HasButtons}" Classes="card" Padding="20,26" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center" Spacing="5">
            <TextBlock Text="No scripts in this tab yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Classes="muted" Text="Add a script to run it with one click and see its output below." HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- runs -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,8,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="OUTPUT" Classes="section" Margin="2,0,0,0" VerticalAlignment="Center"/>
          <Border Classes="chip" IsVisible="{Binding HasRuns}"><TextBlock Text="{Binding Runs.Count}" FontSize="11" Classes="muted"/></Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasRuns}">
          <Button Classes="flat" Click="OnStopAll" ToolTip.Tip="Stop all running scripts in this tab" IsVisible="{Binding HasRunning}">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="stop" Foreground="{DynamicResource DangerBrush}" Width="11" Height="11"/><TextBlock Text="Stop all" FontSize="12" Foreground="{DynamicResource DangerBrush}"/></StackPanel>
          </Button>
          <Button Classes="flat" Click="OnCollapseAll" ToolTip.Tip="Collapse all"><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="collapse"/><TextBlock Text="Collapse" FontSize="12"/></StackPanel></Button>
          <Button Classes="flat" Click="OnExpandAll" ToolTip.Tip="Expand all"><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="expand"/><TextBlock Text="Expand" FontSize="12"/></StackPanel></Button>
          <Button Classes="flat" Click="OnClearFinished" ToolTip.Tip="Remove finished runs"><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="trash"/><TextBlock Text="Clear finished" FontSize="12"/></StackPanel></Button>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" IsVisible="{Binding HasRuns}" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Runs}" Margin="0,0,10,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RunViewModel">
              <views:RunCard/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="1" IsVisible="{Binding !HasRuns}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="20">
          <c:Icon Kind="terminal" Width="28" Height="28" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="Output appears here" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                     Text="Every run gets its own panel with its own output, so scripts running at the same time never mix."/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
