<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:EasyJob.Controls"
             xmlns:svc="using:EasyJob.Services"
             x:Class="EasyJob.Views.CommandsPanel">

  <Grid RowDefinitions="Auto,*,Auto,*,Auto">

    <!-- search -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="12,12,12,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="POWERSHELL COMMANDS" Classes="section" Margin="0" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="flat" Click="OnRefreshClick" ToolTip.Tip="Reload the command list from PowerShell">
          <c:Icon Kind="refresh"/>
        </Button>
      </Grid>
      <TextBox x:Name="SearchBox" Watermark="Search commands and modules…"/>
      <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" SelectedIndex="0">
        <ComboBoxItem Tag="">All types</ComboBoxItem>
        <ComboBoxItem Tag="Cmdlet">Cmdlets</ComboBoxItem>
        <ComboBoxItem Tag="Function">Functions</ComboBoxItem>
        <ComboBoxItem Tag="Alias">Aliases</ComboBoxItem>
      </ComboBox>
    </StackPanel>

    <!-- list -->
    <Border Grid.Row="1" Classes="card" ClipToBounds="True" Margin="12,0,12,0" MinHeight="120">
      <ListBox x:Name="CommandList" Background="Transparent" Padding="4">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="svc:PsCommand">
            <Grid ColumnDefinitions="*,Auto" Margin="2,2" DoubleTapped="OnItemDoubleTapped" Background="Transparent">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Module}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding Type}" FontSize="10.5" Classes="muted"/></Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>

    <!-- details -->
    <ScrollViewer Grid.Row="3" MinHeight="120">
      <StackPanel Margin="14,0,14,10" Spacing="4">
        <TextBlock x:Name="CountText" Classes="muted" FontSize="12"/>
        <TextBlock x:Name="Heading" Classes="h1" TextWrapping="Wrap" FontSize="17"/>
        <TextBlock x:Name="Meta" Classes="muted"/>

        <StackPanel x:Name="Message" IsVisible="False" Spacing="6" Margin="0,20,0,0" HorizontalAlignment="Center">
          <TextBlock x:Name="MessageTitle" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="MessageText" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="Details" IsVisible="False">
          <TextBlock x:Name="Synopsis" TextWrapping="Wrap" Margin="0,8,0,0"/>

          <TextBlock Classes="section" Text="SYNTAX"/>
          <Border Classes="card" Padding="12,9">
            <SelectableTextBlock x:Name="Syntax" TextWrapping="Wrap" FontFamily="Menlo, Cascadia Mono, Consolas, monospace" FontSize="12"/>
          </Border>

          <StackPanel x:Name="DescriptionBlock">
            <TextBlock Classes="section" Text="DESCRIPTION"/>
            <SelectableTextBlock x:Name="Description" TextWrapping="Wrap" LineHeight="19"/>
          </StackPanel>

          <StackPanel x:Name="ExamplesBlock">
            <TextBlock Classes="section" Text="EXAMPLES"/>
            <StackPanel x:Name="Examples" Spacing="8"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="4" Padding="12,9" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Background="{DynamicResource FooterBrush}">
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="InsertButton" Classes="primary" Click="OnInsertClick" IsEnabled="False" Margin="0,0,8,0" ToolTip.Tip="Insert the command name at the cursor (or double-click it)">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="edit"/><TextBlock Text="Insert"/></StackPanel>
        </Button>
        <Button x:Name="CopyNameButton" Click="OnCopyNameClick" IsEnabled="False" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="copy"/><TextBlock Text="Name"/></StackPanel>
        </Button>
        <Button x:Name="CopySyntaxButton" Click="OnCopySyntaxClick" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="copy"/><TextBlock Text="Syntax"/></StackPanel>
        </Button>
      </WrapPanel>
    </Border>
  </Grid>
</UserControl>
